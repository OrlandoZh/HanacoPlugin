+import { describe, expect, it } from "vitest";
+import type { Edge, Node } from "@xyflow/react";
+import {
+  collectHoverNeighborhood,
+  formatAggregatedEdgeLabel,
+} from "../graphFocus";
+
+const nodes = [
+  { id: "a" },
+  { id: "b" },
+  { id: "c" },
+  { id: "group" },
+  { id: "child", parentId: "group" },
+] as Node[];
+
+const edges = [
+  { id: "a-b", source: "a", target: "b" },
+  { id: "b-c", source: "b", target: "c" },
+] as Edge[];
+
+describe("formatAggregatedEdgeLabel", () => {
+  it("shows relationship types for flat human-scale graphs", () => {
+    expect(formatAggregatedEdgeLabel(1, ["calls"], true)).toBe("calls");
+    expect(formatAggregatedEdgeLabel(3, ["calls", "imports"], true)).toBe("calls · imports");
+  });
+
+  it("hides meaningless singleton counts for grouped graphs", () => {
+    expect(formatAggregatedEdgeLabel(1, ["calls"], false)).toBe("");
+    expect(formatAggregatedEdgeLabel(4, ["calls"], false)).toBe("4");
+  });
+});
+
+describe("collectHoverNeighborhood", () => {
+  it("keeps only the hovered node and its one-hop graph neighbors", () => {
+    expect([...collectHoverNeighborhood("a", nodes, edges)].sort()).toEqual(["a", "b"]);
+  });
+
+  it("keeps a nested node together with its parent container", () => {
+    expect([...collectHoverNeighborhood("child", nodes, edges)].sort()).toEqual([
+      "child",
+      "group",
+    ]);
+  });
+
+  it("keeps direct children when hovering their parent container", () => {
+    expect([...collectHoverNeighborhood("group", nodes, edges)].sort()).toEqual([
+      "child",
+      "group",
+    ]);
+  });
+});
