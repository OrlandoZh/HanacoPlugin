+import type { Edge, Node } from "@xyflow/react";
+
+export function formatAggregatedEdgeLabel(
+  count: number,
+  edgeTypes: string[],
+  showTypes: boolean,
+): string {
+  if (showTypes && edgeTypes.length > 0) {
+    return edgeTypes.join(" · ");
+  }
+  return count === 1 ? "" : String(count);
+}
+
+/**
+ * Collect the hovered node, its one-hop graph neighbors, and direct
+ * parent/children so nested React Flow nodes never fade their own container.
+ */
+export function collectHoverNeighborhood(
+  hoveredNodeId: string,
+  nodes: Pick<Node, "id" | "parentId">[],
+  edges: Pick<Edge, "source" | "target">[],
+): Set<string> {
+  const visible = new Set<string>([hoveredNodeId]);
+
+  for (const edge of edges) {
+    if (edge.source === hoveredNodeId) visible.add(String(edge.target));
+    if (edge.target === hoveredNodeId) visible.add(String(edge.source));
+  }
+
+  const hoveredNode = nodes.find((node) => node.id === hoveredNodeId);
+  if (hoveredNode?.parentId) visible.add(hoveredNode.parentId);
+  for (const node of nodes) {
+    if (node.parentId === hoveredNodeId) visible.add(node.id);
+  }
+
+  return visible;
+}
